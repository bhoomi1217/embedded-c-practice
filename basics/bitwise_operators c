#include <stdio.h>

int main()
{
    int x = 5;   // Binary: 0101

    printf("Original value = %d\n", x);

    // Set bit 1
    x = x | (1 << 1);
    printf("After setting bit 1 = %d\n", x);

    // Clear bit 2
    x = x & ~(1 << 2);
    printf("After clearing bit 2 = %d\n", x);

    // Toggle bit 0
    x = x ^ (1 << 0);
    printf("After toggling bit 0 = %d\n", x);

    return 0;
}
