#include <stdio.h>

int main()
{
    int x = 13;

    printf("Original value = %d\n", x);

    // Set bit 1
    x = x | (1 << 1);
    printf("After setting bit 1 = %d\n", x);

    // Clear bit 3
    x = x & ~(1 << 3);
    printf("After clearing bit 3 = %d\n", x);

    // Toggle bit 0
    x = x ^ (1 << 0);
    printf("After toggling bit 0 = %d\n", x);

    // Check bit 2
    if (x & (1 << 2))
    {
        printf("Bit 2 is set\n");
    }
    else
    {
        printf("Bit 2 is clear\n");
    }

    return 0;
}
